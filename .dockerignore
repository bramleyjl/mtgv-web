# Ignore node_modules, as they will be installed inside the container
node_modules

# Ignore local environment files
.env
.env.*
!.env.example
!env.example

# Ignore Git repository files
.git
.gitignore

# Ignore Docker related files
Dockerfile
.dockerignore

# Ignore build output (rebuilt in the container)
.next
coverage
tsconfig.tsbuildinfo

# Ignore editor/IDE specific files
.vscode/
